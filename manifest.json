{
  "manifest_version": 2,
  "name": "New Tab",
  "version": "0.1.2",
  "description": "A personal, local-first replacement for Firefox's New Tab page.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["js/background.js"],
    "persistent": false
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://feeds.bbci.co.uk/*",
    "https://ac.duckduckgo.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://ac.ecosia.org/*",
    "https://en.wikipedia.org/*",
    "https://*.icloud.com/*",
    "https://admin.dollopsicecream.co.uk/*",
    "https://dummyjson.com/*",
    "https://api.frankfurter.app/*",
    "https://api.sunrise-sunset.org/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://ics.fixtur.es/*",
    "https://ics.ecal.com/*",
    "https://smithton.churchsuite.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-dashboard@local.ext",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
